# Copy to .env for local testing only. MCP clients (Claude Desktop/Code, Cursor)
# read these from their own config's "env" block, not from this file — see README.md.

# Required
TITAN_EMAIL=you@yourdomain.com
TITAN_PASSWORD=your-titan-app-password

# Optional — selects IMAP/SMTP host+port defaults. One of: titan (default), godaddy.
# Leave unset if you're on native Titan Email. Set to "godaddy" if your domain/mailbox
# was bought through GoDaddy and uses GoDaddy's mail servers.
TITAN_PROVIDER=titan

# Optional — overrides the provider preset above. Only needed for a reseller that
# isn't titan or godaddy (check your welcome email for the exact IMAP/SMTP hostnames).
# TITAN_IMAP_HOST=imap.titan.email
# TITAN_IMAP_PORT=993
# TITAN_SMTP_HOST=smtp.titan.email
# TITAN_SMTP_PORT=465

# Optional
TITAN_FROM_NAME=Your Name
TITAN_ALLOW_SEND=true
TITAN_SENT_FOLDER=Sent
TITAN_DRAFTS_FOLDER=Drafts
